# Optional port for local development.
APP_PORT=8000

# Public Supabase Auth config.
# Never expose a service_role/secret key in the browser.
# Required for real registration/login and JWT verification.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# Optional alias for newer Supabase projects.
# SUPABASE_PUBLISHABLE_KEY=
# Optional Auth request timeout.
# SUPABASE_AUTH_TIMEOUT_SECONDS=10
